# Database Configuration (PostgreSQL)
# DATABASE_URL: Dùng cho FastAPI app (quyền chỉ đọc SELECT)
DATABASE_URL=postgresql+psycopg://phone_app:phone_app_secret@localhost:5432/phone_advisor

# DATABASE_ADMIN_URL: Dùng cho Alembic migration và seed scripts (quyền DDL/DML)
DATABASE_ADMIN_URL=postgresql+psycopg://phone_admin:phone_admin_secret@localhost:5432/phone_advisor

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=30

# App Security & Session
SECRET_KEY=change_this_to_a_random_secret_key_in_production
SESSION_COOKIE_NAME=phone_advisor_session
SESSION_MAX_AGE_SECONDS=1800
ENVIRONMENT=development

